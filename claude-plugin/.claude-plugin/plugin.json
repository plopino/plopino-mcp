{
  "name": "plopino",
  "displayName": "Plopino",
  "version": "0.3.3",
  "description": "Publish pages, documents, and multi-file bundles from Claude to public Plopino links.",
  "author": {
    "name": "Plopino",
    "url": "https://plopino.com"
  },
  "homepage": "https://plopino.com",
  "repository": "https://github.com/plopino/plopino-mcp",
  "license": "MIT",
  "keywords": [
    "publishing",
    "share",
    "html",
    "documents",
    "links"
  ],
  "icon": "./icon.png",
  "documentationUrl": "https://github.com/plopino/plopino-mcp#readme",
  "supportUrl": "https://plopino.com/feedback",
  "privacyPolicyUrl": "https://plopino.com/privacy",
  "termsOfServiceUrl": "https://plopino.com/terms",
  "userConfig": {
    "token": {
      "type": "string",
      "title": "Plopino token (optional)",
      "description": "Leave empty to publish anonymously. A token from plopino.com/b publishes to your account, keeps content permanently, and enables in-place updates.",
      "sensitive": true,
      "required": false
    }
  }
}
